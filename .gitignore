app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local CocoaPods/native build artifacts
/ios/.symlinks/
/ios/Flutter/Flutter.podspec
/ios/Flutter/ephemeral/
/ios/Pods/
/ios/Podfile
/ios/Podfile.lock
/ios/Runner.xcworkspace/xcuserdata/
/macos/Flutter/ephemeral/
/macos/Pods/
/macos/Podfile
/macos/Podfile.lock
/macos/Runner.xcworkspace/xcuserdata/

# Local/private inputs and generated image derivatives
/tooling/
/tmp/
/research/
/assets/kansen/

# Native launcher icon / splash image binaries are regenerated from private
# artwork; never commit them. Blanket-ignore any PNG under the Android res
# tree and the iOS asset-catalog imagesets the project uses for icon/splash.
/android/app/src/main/res/**/*.png
/ios/Runner/Assets.xcassets/AppIcon.appiconset/*.png
/ios/Runner/Assets.xcassets/LaunchImage.imageset/*.png
